{
  "mcpServers": {
    "supabase-sql": {
      "command": "supabase-mcp",
      "env": {
        "SUPABASE_PG_URL": "${SUPABASE_PG_URL}",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "mt-mcp": {
      "type": "http",
      "url": "${MT_MCP_URL:-http://127.0.0.1:8000/mcp/}",
      "headersHelper": "mt mcp headers"
    }
  }
}
