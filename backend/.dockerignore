# Keep the build context to source. The image installs its own dependencies
# via `uv sync` in the Dockerfile, so anything generated by working in this
# directory locally is dead weight that also invalidates the layer cache.
#
# SB-860: this file did not exclude .venv, so `COPY . .` baked the local
# 729MB virtualenv into the image and `uv sync` then built a second one. That
# is why the locally built missing-table-worker was 3.87GB while the CI-built
# missing-table-backend, from this same Dockerfile but a clean checkout, was
# 844MB. Every rebuild orphaned another 3.87GB copy.

# Virtualenvs — the image builds its own
.venv/
venv/
ENV/

# Python bytecode and caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
**/.pytest_cache/

# Test and coverage artefacts
htmlcov/
coverage.json
.coverage
.coverage.*
coverage.xml
*.cover
tests/logs/

# Runtime output
logs/
*.log

# Environment files - use Kubernetes env vars instead
.env
.env.*
!.env.example

# Local tooling
fly.toml
.DS_Store
