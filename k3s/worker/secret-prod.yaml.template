apiVersion: v1
kind: Secret
metadata:
  name: missing-table-worker-prod-secrets
  namespace: match-scraper
  labels:
    app: missing-table-worker
    environment: prod
type: Opaque
stringData:
  # IMPORTANT: Replace these with your PRODUCTION Supabase credentials
  # Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

  # Supabase Service Key (production)
  SUPABASE_KEY: "YOUR_PRODUCTION_SERVICE_KEY_HERE"

  # Supabase JWT Secret (production)
  SUPABASE_JWT_SECRET: "YOUR_PRODUCTION_JWT_SECRET_HERE"

  # Service Account Secret (production)
  # Generate with: openssl rand -base64 32
  SERVICE_ACCOUNT_SECRET: "YOUR_PRODUCTION_SERVICE_ACCOUNT_SECRET"

  # Telegram bot token for ingest-failure alerts (SB-829).
  # Reuse the bot the scraper already reports through — the value is on
  # secret/match-scraper-agent-secret as AGENT_TELEGRAM_BOT_TOKEN. Copy it
  # cluster-side rather than through a shell that logs its command line.
  #
  # Without this the worker still consumes matches and still records
  # failures; only the push alert is skipped, and it is skipped SILENTLY.
  TELEGRAM_BOT_TOKEN: "YOUR_TELEGRAM_BOT_TOKEN"
